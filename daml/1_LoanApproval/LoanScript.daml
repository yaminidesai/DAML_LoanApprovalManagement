module LoanScript where

import Daml.Script
import LoanApproval

test_loan : Script ()
test_loan = script do

-- Party allocation
  bank <- allocateParty "Goldman Sachs"
  borrower <- allocateParty "Yami"
  borrower2 <- allocateParty "Akhil"
  borrower3 <- allocateParty "Bheema"

-- Yami: $1000 loan, $5000 salary → 20% DTI, approved
  loanRequest <- submit borrower do
    createCmd LoanRequest with
      bank = bank
      borrower = borrower
      salary = 5000.0
      loanAmount = 1000.0

  _loan <- submit bank do
    exerciseCmd loanRequest ApproveRequest

-- Akhil: $1,000,000 loan, $50,000 salary → bank rejects explicitly
  loanRequest2 <- submit borrower2 do
    createCmd LoanRequest with
      bank = bank
      borrower = borrower2
      salary = 50000.0
      loanAmount = 1000000.0

  _loan2 <- submit bank do
    exerciseCmd loanRequest2 RejectRequest

-- Bheema: $100 loan, $1000 salary → request left unprocessed (demonstrates pending)
  _loanRequest3 <- submit borrower3 do
    createCmd LoanRequest with
      bank = bank
      borrower = borrower3
      salary = 1000.0
      loanAmount = 100.0

  return ()
