module LoanRepayment where

-- LoanStatus
--   Typed status replaces the previous status : Text field. A typo like
--   "Approvd" no longer compiles.
data LoanStatus = Approved | Rejected
  deriving (Eq, Show)

-- 1. TokenWallet Template — Account-Based Model
--
-- FINANCIAL CONTEXT:
--   Same custodial account model as Module 2. Holds the borrower's
--   token balance and is the source of funds for loan repayments.
--   When the borrower exercises Repay on the Loan contract, it internally
--   exercises the Debit choice here to pull the repayment amount from
--   the wallet. The wallet balance must cover each repayment — insufficient
--   balance fails the Debit assertion before any state changes are committed.
--
-- SIGNATORIES: issuer, owner
--   Dual signatories: custodial relationship between bank and borrower.
--
-- OBSERVERS: none
--   The borrower's wallet balance is private to the two contracting parties.
--
-- COMPLIANCE:
--   GDPR Article 5(1)(c) — data minimization. Wallet balance data is
--   scoped to the minimum necessary parties.
--
-- MIGRATION NOTE:
--   Uses a contract key (keyed by owner) for fetchByKey lookup. Contract
--   keys are not supported in DAML 3.x LF 2.1. The key is not actively
--   used in the current repayment scripts — wallet ContractIds are tracked
--   off-ledger and passed explicitly to each choice. A future refactor
--   targeting DAML 3.x should remove the key and evaluate the Participant
--   Query Store as the recommended replacement pattern.
template TokenWallet
  with
    owner : Party
    issuer : Party
    tokenAmount : Decimal
  where
    signatory issuer, owner
    key owner : Party
    maintainer key

    choice Credit : ContractId TokenWallet
      with
        amount : Decimal
      controller issuer
        do
          assertMsg "The amount should be positive" (amount > 0.0)
          create this with
            tokenAmount = tokenAmount + amount

    choice Debit : ContractId TokenWallet
      with
        amount : Decimal
      controller owner
        do
          assertMsg "Insufficient balance" (amount <= tokenAmount)
          assertMsg "Sent amount should be greater than zero" (amount > 0.0)
          create this with
            tokenAmount = tokenAmount - amount

-- 2. LoanLimit Template
--
-- FINANCIAL CONTEXT:
--   Extends the Module 2 LoanLimit with end-of-loan capacity restoration.
--   The totalLimit decrements by loanAmount on approval (CheckLimit). It
--   only increases again when a loan is fully repaid and the Repay choice
--   archives the Loan contract — at that point RestoreCapacity returns
--   the full disbursedAmount to the pool. Partial repayments do not
--   restore capacity; the bank's available headroom only reflects loans
--   that have actually closed.
--
-- SIGNATORIES: issuer
--   The bank controls lending capacity as an internal institutional resource.
--
-- OBSERVERS: owner
--   The borrower is added as an observer so they can reference and
--   exercise on this contract from within the Repay flow on the Loan
--   contract (which is owner-controlled).
--
-- COMPLIANCE:
--   FDIC Interagency Guidelines for Credit Concentration Risk — capacity
--   restoration on loan archive maintains accurate on-ledger representation
--   of the bank's net credit exposure.
--   12 USC 84 (OCC Legal Lending Limit) — totalLimit tracks aggregate
--   institutional exposure, complementary to the per-borrower statutory cap.
template LoanLimit
  with
    issuer : Party
    owner : Party
    loanLimit : Decimal
    loanRequested : Decimal
    totalLimit : Decimal
  where
    signatory issuer
    observer owner

    choice CheckLimit : ContractId LoanLimit
      with
        loanAmount : Decimal
        salary : Decimal
      controller issuer
        do
          assertMsg "Loan must be within 25% of the salary"
            (loanAmount <= 0.25 * salary)
          assertMsg "Loan Limit Exceeded" (loanAmount <= totalLimit)
          create this with
            loanLimit = 0.25 * salary
            totalLimit = totalLimit - loanAmount
            loanRequested = loanAmount

    -- Restores lending capacity to the pool. Exercised once, when a Loan
    -- is fully repaid and about to archive, with the loan's disbursedAmount.
    choice RestoreCapacity : ContractId LoanLimit
      with
        amount : Decimal
      controller issuer
        do
          assertMsg "Restore amount must be positive" (amount > 0.0)
          create this with
            totalLimit = totalLimit + amount

-- 3. LoanRequest Template
--
-- FINANCIAL CONTEXT:
--   Same shape as Module 2: borrower submits salary + amount; ApproveRequest
--   asserts the 25% DTI rule and exercises CheckLimit. A failing request
--   aborts the transaction rather than silently producing a Rejected
--   loan. Explicit rejections go through RejectRequest.
--
-- SIGNATORIES: owner (borrower)
-- OBSERVERS: issuer (bank)
--
-- COMPLIANCE:
--   CFPB Ability-to-Repay (Regulation Z) — DTI assertion is the contract
--   gate on loan creation.
--   BSA Section 1020.220 — borrower party = identified loan applicant.
template LoanRequest
  with
    loanLimitCid : ContractId LoanLimit
    issuer : Party
    owner : Party
    salary : Decimal
    loanAmount : Decimal
  where
    ensure loanAmount > 0.0 && salary > 0.0
    signatory owner
    observer issuer

    choice ApproveRequest : ContractId Loan
      controller issuer
      do
        assertMsg "Loan exceeds 25% of stated salary (CFPB Ability-to-Repay)"
          (loanAmount <= 0.25 * salary)
        _ <- exercise loanLimitCid CheckLimit with
          salary = salary
          loanAmount = loanAmount
        create Loan with
          issuer
          owner
          loanAmount
          disbursedAmount = 0.0
          status = Approved
          repaidAmount = 0.0

    choice RejectRequest : ContractId Loan
      controller issuer
      do
        create Loan with
          issuer
          owner
          loanAmount
          disbursedAmount = 0.0
          status = Rejected
          repaidAmount = 0.0

-- 4. Loan Template
--
-- FINANCIAL CONTEXT:
--   Approval, disbursement, and repayment in a single template.
--   repaidAmount tracks cumulative repayments against disbursedAmount.
--   The Repay choice validates against a runtime-fetched minimum payment
--   threshold (computed from LoanRepaymentRestriction.minimumPercent *
--   disbursedAmount), debits the borrower's wallet, and either updates
--   the loan with the new repaidAmount (partial) or archives the contract
--   and restores capacity to the LoanLimit pool (full). The Optional
--   ContractId Loan return type forces the caller to handle both outcomes.
--
-- SIGNATORIES: issuer, owner
-- OBSERVERS: none
--
-- COMPLIANCE:
--   CFPB Regulation Z — disbursement and repayment limits are enforced
--   as contract assertions; over-disbursement and below-minimum repayment
--   are structurally impossible.
--   FDIC Credit Concentration Guidelines — capacity is restored to
--   LoanLimit only on full repayment, keeping net exposure accurate.
template Loan
  with
    issuer : Party
    owner : Party
    loanAmount : Decimal
    disbursedAmount : Decimal
    status : LoanStatus
    repaidAmount : Decimal
  where
    signatory issuer, owner

    choice Disburse : ContractId Loan
      with
        disAmount : Decimal
        tokenWalletCid : ContractId TokenWallet
      controller issuer
      do
        assertMsg "Disbursement Amount must be positive" (disAmount > 0.0)
        assertMsg "Disbursement exceeds remaining limit"
          (disbursedAmount + disAmount <= loanAmount)
        _ <- exercise tokenWalletCid Credit with amount = disAmount
        create this with
          disbursedAmount = disbursedAmount + disAmount

    choice Repay : (Optional (ContractId Loan), ContractId TokenWallet, ContractId LoanLimit)
      with
        repay : Decimal
        tokenWalletCid : ContractId TokenWallet
        repaymentRestrictionCid : ContractId LoanRepaymentRestriction
        loanLimitCid : ContractId LoanLimit
      controller owner
      do
        repayRestriction <- fetch repaymentRestrictionCid
        let minimumPay = repayRestriction.minimumPercent * disbursedAmount
        assertMsg "Repayment must be >= minimumPercent * disbursedAmount"
          (repay >= minimumPay)
        assertMsg "Repayment must not exceed outstanding balance"
          (repaidAmount + repay <= disbursedAmount)

        newWalletCid <- exercise tokenWalletCid Debit with amount = repay

        let newRepaid = repaidAmount + repay
        if newRepaid >= disbursedAmount then do
          -- Full repayment: restore the disbursed amount to the lending
          -- pool and let the Loan contract archive.
          newLimitCid <- exercise loanLimitCid RestoreCapacity
            with amount = disbursedAmount
          return (None, newWalletCid, newLimitCid)
        else do
          -- Partial repayment: update the loan, keep LoanLimit untouched.
          newLoanCid <- create this with
            repaidAmount = newRepaid
          return (Some newLoanCid, newWalletCid, loanLimitCid)

-- 5. LoanRepaymentRestriction Template
--
-- FINANCIAL CONTEXT:
--   Bank-set minimum repayment policy expressed as a percentage of
--   disbursedAmount (e.g. 0.05 for 5%). Stored as a standalone contract
--   so the bank can update policy without redeploying Loan templates,
--   and so a single restriction applies to any number of loans for the
--   given borrower. Repay fetches this contract and computes the
--   per-loan minimum at execution time using the loan's own
--   disbursedAmount — so a borrower with multiple loans uses one
--   restriction across all of them.
--
-- SIGNATORIES: issuer
--   Minimum repayment thresholds are unilateral bank policy.
--
-- OBSERVERS: owner
--   The borrower observes so they can reference the contract from inside
--   the owner-controlled Repay choice.
--
-- COMPLIANCE:
--   CFPB Ability-to-Repay (Regulation Z) — minimum repayment enforcement
--   prevents micro-payments that don't meaningfully reduce the balance.
--   Storing the threshold as a percent (not a per-loan absolute) means
--   updating bank policy is a single contract update, not a per-loan
--   migration.
template LoanRepaymentRestriction
  with
    issuer : Party
    owner : Party
    minimumPercent : Decimal
  where
    ensure minimumPercent > 0.0 && minimumPercent <= 1.0
    signatory issuer
    observer owner
