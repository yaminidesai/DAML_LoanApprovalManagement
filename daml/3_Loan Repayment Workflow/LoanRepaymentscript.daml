module LoanRepaymentscript where

import LoanRepayment
import Daml.Script

test_Repayment : Script ()
test_Repayment = script do

-- Party allocation
  issuer <- allocateParty "Bank"
  owner <- allocateParty "Akhil"
  borrower2 <- allocateParty "Yami"
  borrower3 <- allocateParty "Bheema"
  borrower4 <- allocateParty "shashi"

-- Token wallet for the owner
  tokenCid <- submitMulti [issuer, owner] [] do
    createCmd TokenWallet with
      issuer = issuer
      owner = owner
      tokenAmount = 0.0

-- Bank sets initial lending pool of 100,000
  loanLimitCid1 <- submit issuer do
    createCmd LoanLimit with
      issuer = issuer
      owner = owner
      loanLimit = 0.0
      loanRequested = 0.0
      totalLimit = 100000.0

-- borrower2 (Yami): $10k loan with $10k salary → 100% DTI, must fail
  loanRequestCid1 <- submit borrower2 do
    createCmd LoanRequest with
      issuer = issuer
      owner = borrower2
      salary = 10000.0
      loanAmount = 10000.0
      loanLimitCid = loanLimitCid1

  submitMustFail issuer do
    exerciseCmd loanRequestCid1 ApproveRequest

-- owner (Akhil): $5k loan with $50k salary → 10% DTI, approved
  loanRequestCid2 <- submit owner do
    createCmd LoanRequest with
      issuer = issuer
      owner = owner
      salary = 50000.0
      loanAmount = 5000.0
      loanLimitCid = loanLimitCid1

  loanCid2 <- submit issuer do
    exerciseCmd loanRequestCid2 ApproveRequest

-- Disburse $5k into the wallet
  _disburseCid <- submit issuer do
    exerciseCmd loanCid2 Disburse with
      disAmount = 5000.0
      tokenWalletCid = tokenCid

-- Fetch active LoanLimit (totalLimit now 95000)
  loanLimits : [(ContractId LoanLimit, LoanLimit)] <- query @LoanLimit issuer
  let [(loanLimitCid5_2, _)] = [ (cid, ll) | (cid, ll) <- loanLimits, ll.totalLimit == 95000.0 ]

-- borrower3 (Bheema): $2k loan with $15k salary → 13.3% DTI, approved
  loanRequestCid3 <- submit borrower3 do
    createCmd LoanRequest with
      issuer = issuer
      owner = borrower3
      salary = 15000.0
      loanAmount = 2000.0
      loanLimitCid = loanLimitCid5_2

  _loanCid3 <- submit issuer do
    exerciseCmd loanRequestCid3 ApproveRequest

-- Fetch active LoanLimit (totalLimit now 93000)
  loanLimits2 : [(ContractId LoanLimit, LoanLimit)] <- query @LoanLimit issuer
  let [(loanLimitCid8_2, _)] = [ (cid, ll) | (cid, ll) <- loanLimits2, ll.totalLimit == 93000.0 ]

-- borrower4 (shashi): $50k loan with $25k salary → 200% DTI, must fail
  loanRequestCid4 <- submit borrower4 do
    createCmd LoanRequest with
      issuer = issuer
      owner = borrower4
      salary = 25000.0
      loanAmount = 50000.0
      loanLimitCid = loanLimitCid8_2

  submitMustFail issuer do
    exerciseCmd loanRequestCid4 ApproveRequest

-- Bank policy: 5% minimum payment. One restriction reusable across loans.
  restrictionCid <- submit issuer do
    createCmd LoanRepaymentRestriction with
      issuer = issuer
      owner = owner
      minimumPercent = 0.05

-- Find the disbursed Loan contract for the owner
  activeLoans : [(ContractId Loan, Loan)] <- query @Loan issuer
  let [(newLoanCid, _)] =
        [ (cid, loan)
        | (cid, loan) <- activeLoans
        , loan.owner == owner && loan.disbursedAmount == 5000.0
        ]

-- Find the owner's current wallet
  activeTokenWallets : [(ContractId TokenWallet, TokenWallet)] <- query @TokenWallet owner
  let [(updatedTokenCid, _)] =
        [ (cid, tw) | (cid, tw) <- activeTokenWallets, tw.owner == owner ]

-- Repayment 1: $500 (>= 5% of $5000 = $250)
  (loanCidOpt1, walletCid1, newLoanLimitCid) <- submit owner do
    exerciseCmd newLoanCid Repay with
      repay = 500.0
      tokenWalletCid = updatedTokenCid
      repaymentRestrictionCid = restrictionCid
      loanLimitCid = loanLimitCid8_2

  let veryNewCid = case loanCidOpt1 of
        Some cid -> cid
        None     -> error "Unexpected: loan fully repaid on first payment"

-- Repayment 2: $800
  (loanCidOpt2, walletCid2, newLoanLimitCid2) <- submit owner do
    exerciseCmd veryNewCid Repay with
      repay = 800.0
      tokenWalletCid = walletCid1
      repaymentRestrictionCid = restrictionCid
      loanLimitCid = newLoanLimitCid

  let veryNewCid2 = case loanCidOpt2 of
        Some cid -> cid
        None     -> error "Unexpected: loan fully repaid on second payment"

-- Repayment 3: $3700 closes out the loan ($500 + $800 + $3700 = $5000)
-- Loan archives; LoanLimit restored from 93000 → 98000.
  (_loanCidOpt3, _walletCid3, _newLoanLimitCid3) <- submit owner do
    exerciseCmd veryNewCid2 Repay with
      repay = 3700.0
      tokenWalletCid = walletCid2
      repaymentRestrictionCid = restrictionCid
      loanLimitCid = newLoanLimitCid2

  return ()
